#!/bin/bash
# 转录小工具 · 本机助手
# 网页点转录或双击本程序时运行：准备环境、拉起本地服务。
# 不打开 127.0.0.1：测试从公开网页进来，准备好后回到原来的网页继续。
set -u

SCHEME_LAUNCH=0
for arg in "$@"; do
  case "$arg" in
    media-transcriber://*) SCHEME_LAUNCH=1 ;;
  esac
done

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
CONTENTS="$(cd "$HERE/.." && pwd)"
RESOURCES="$CONTENTS/Resources"
ROOT="$(cd "$CONTENTS/.." && pwd)"
DATA="${HOME}/Library/Application Support/media-transcriber"
LOG_DIR="${HOME}/Library/Logs"
LOG="$LOG_DIR/media-transcriber.log"
PIDFILE="$DATA/server.pid"
PORT="${MT_PORT:-8766}"
LOCAL="http://127.0.0.1:${PORT}"
REPO="hotcatty/media-transcriber"
ARCH="$(uname -m)"

mkdir -p "$DATA/bin" "$DATA/app" "$DATA/python" "$LOG_DIR"
# Keep stdout free so $(...) helpers can return a path. All logs go to the file.
exec 2>>"$LOG"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; }

notify() {
  /usr/bin/osascript -e "display notification \"$2\" with title \"转录小工具\"" >/dev/null 2>&1 || true
}

alert() {
  /usr/bin/osascript -e "display dialog \"$1\" with title \"转录小工具\" buttons {\"好\"} default button \"好\"" >/dev/null 2>&1 || true
}

helper_ready() {
  local body
  body="$(curl -fsS --max-time 1 "${LOCAL}/api/ping" 2>/dev/null)" || return 1
  printf '%s' "$body" | grep -q '"app":"media-transcriber"\|"app": "media-transcriber"' || return 1
  printf '%s' "$body" | grep -q '"preparing": true\|"preparing":true' && return 1
  return 0
}

if helper_ready; then
  log "already running scheme=$SCHEME_LAUNCH"
  notify "已经准备好" "回到原来的网页就能继续转录。"
  exit 0
fi

export MT_HOST="127.0.0.1"
export MT_PORT="$PORT"
export MT_TEMP_DIR="$DATA/temp"
export MT_COOKIE_FILE="$DATA/cookies.txt"
export MT_MODELS_DIR="${HOME}/.cache/media-transcriber/models"
export MT_FFMPEG="$DATA/bin/ffmpeg"
export MT_FFPROBE="$DATA/bin/ffprobe"
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
# Do not pin a single PyPI mirror: tuna often returns 403 off-campus.
unset UV_INDEX_URL PIP_INDEX_URL
export UV_PYTHON_INSTALL_MIRROR="${UV_PYTHON_INSTALL_MIRROR:-https://cdn.npmmirror.com/binaries/python-build-standalone}"
if [[ -d "$RESOURCES/python" && -n "$(find "$RESOURCES/python" -type f 2>/dev/null | head -1)" ]]; then
  export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$RESOURCES/python}"
else
  export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$DATA/python}"
fi
export PATH="$DATA/bin:$RESOURCES/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

WAITING="$RESOURCES/waiting.html"
BOOT_PID=""

stop_bootstrap() {
  if [[ -n "${BOOT_PID}" ]] && kill -0 "$BOOT_PID" 2>/dev/null; then
    kill "$BOOT_PID" 2>/dev/null || true
    wait "$BOOT_PID" 2>/dev/null || true
  fi
  BOOT_PID=""
}

start_bootstrap() {
  if helper_ready; then
    return 0
  fi
  if curl -fsS --max-time 1 "${LOCAL}/api/ping" >/dev/null 2>&1; then
    return 0
  fi
  local py=""
  if command -v python3 >/dev/null 2>&1; then
    py="$(command -v python3)"
  elif [[ -x /usr/bin/python3 ]]; then
    py="/usr/bin/python3"
  fi
  [[ -n "$py" ]] || return 0
  "$py" -c 'import http.server' >/dev/null 2>&1 || return 0
  (
    PORT="$PORT" WAITING="$WAITING" "$py" - <<'PY'
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = int(os.environ["PORT"])
waiting_path = Path(os.environ.get("WAITING", ""))
WAITING = waiting_path.read_bytes() if waiting_path.is_file() else b""
PING = b'{"ok":true,"app":"media-transcriber","preparing":true}'

class H(BaseHTTPRequestHandler):
    def log_message(self, *args):
        return

    def _cors(self):
        origin = self.headers.get("Origin", "*")
        self.send_header("Access-Control-Allow-Origin", origin)
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("Access-Control-Allow-Methods", "GET,POST,OPTIONS")
        self.send_header(
            "Access-Control-Allow-Headers",
            self.headers.get("Access-Control-Request-Headers", "*"),
        )

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/api/ping":
            body = PING
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self._cors()
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self._cors()
        self.send_header("Content-Length", str(len(WAITING)))
        self.end_headers()
        self.wfile.write(WAITING)

ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()
PY
  ) &
  BOOT_PID="$!"
}

notify "正在打开" "第一次准备大约需要几分钟，之后打开网址就能用。"
start_bootstrap

copy_exec() {
  local from="$1" to="$2"
  cp -X "$from" "$to" 2>/dev/null || cp "$from" "$to"
  xattr -cr "$to" 2>/dev/null || true
  xattr -d com.apple.quarantine "$to" 2>/dev/null || true
  chmod +x "$to"
}

# True if this Mac can actually execute the binary (catches ARM uv on Intel).
runs_here() {
  local p="$1"
  [[ -n "$p" && -x "$p" ]] || return 1
  "$p" --version >/dev/null 2>&1 && return 0
  "$p" -version >/dev/null 2>&1 && return 0
  return 1
}

build_diagnostics() {
  printf '%s\n' "转录小工具 诊断"
  printf '%s\n' "time=$(date '+%Y-%m-%d %H:%M:%S')"
  printf '%s\n' "launcher=20260910h"
  printf '%s\n' "arch=$ARCH"
  sw_vers 2>/dev/null | sed 's/^/sw_vers /' || true
  printf '%s\n' "here=$HERE"
  printf '%s\n' "root=$ROOT"
  printf '%s\n' "resources=$RESOURCES"
  printf '%s\n' "ls_resources=$(ls "$RESOURCES" 2>/dev/null | tr '\n' ' ')"
  printf '%s\n' "ls_python=$(ls "$RESOURCES/python" 2>/dev/null | tr '\n' ' ')"
  printf '%s\n' "uv_file=$(/usr/bin/file -b "$DATA/bin/uv" 2>/dev/null || true)"
  printf '%s\n' "error=$1"
  printf '%s\n' "---- log ----"
  if [[ -f "$LOG" ]]; then
    grep -viE 'cookie|authorization|token=|password' "$LOG" | tail -n 200
  else
    printf '%s\n' "(no log)"
  fi
}

write_diag_html() {
  local txt="$1" html="$2"
  {
    cat <<'EOF'
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>转录小工具 · 说明</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; margin: 24px; color: #111; }
  h1 { font-size: 18px; margin: 0 0 8px; }
  p { color: #555; line-height: 1.5; }
  button { font-size: 16px; padding: 8px 16px; margin: 8px 12px 16px 0; }
  textarea { width: 100%; height: 70vh; font: 13px ui-monospace, Menlo, monospace; }
</style>
</head>
<body>
<h1>转录小工具 · 说明</h1>
<p>不会上传到网上。跨设备发给我时，请下载成 .txt 文件再发，不要整段粘贴。</p>
<p>「下载」文件夹里也有一份「转录小工具-说明.txt」。</p>
<p>
<button type="button" id="dl">下载说明.txt</button>
<button type="button" id="btn">复制说明</button>
<span id="ok"></span>
</p>
<textarea id="log" readonly>
EOF
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' "$txt" | sed 's#</textarea>#&lt;/textarea&gt;#g'
    cat <<'EOF'
</textarea>
<script>
var t = document.getElementById("log");
var name = "转录小工具-说明.txt";
document.getElementById("dl").onclick = function () {
  var blob = new Blob([t.value], {type: "text/plain;charset=utf-8"});
  var url = URL.createObjectURL(blob);
  var a = document.createElement("a");
  a.href = url;
  a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
  document.getElementById("ok").textContent = "已开始下载。也可在「下载」文件夹里找同名文件。";
};
document.getElementById("btn").onclick = function () {
  t.focus();
  t.select();
  var ok = false;
  try { ok = document.execCommand("copy"); } catch (e) {}
  function done() {
    document.getElementById("btn").textContent = "已复制";
    document.getElementById("ok").textContent = "可以粘贴了；跨设备请改发 .txt 文件。";
  }
  if (ok) { done(); return; }
  if (navigator.clipboard) {
    navigator.clipboard.writeText(t.value).then(done).catch(function () {});
  }
};
</script>
</body>
</html>
EOF
  } >"$html"
}

fail() {
  log "ERROR: $*"
  stop_bootstrap
  local diag_file="$LOG_DIR/media-transcriber-diag.txt"
  local diag_html="$LOG_DIR/media-transcriber-diag.html"
  local diag_dl="$HOME/Downloads/转录小工具-说明.txt"
  build_diagnostics "$*" >"$diag_file" 2>/dev/null || true
  mkdir -p "$HOME/Downloads"
  cp "$diag_file" "$diag_dl" 2>/dev/null || true
  write_diag_html "$diag_file" "$diag_html"
  /usr/bin/open -R "$diag_dl" >/dev/null 2>&1 || true
  /usr/bin/open -a Safari "$diag_html" >/dev/null 2>&1 \
    || /usr/bin/open "$diag_html" >/dev/null 2>&1 \
    || /usr/bin/open -e "$diag_file" >/dev/null 2>&1 \
    || true
  /usr/bin/osascript - "本机组件没准备好。$* 说明已放到「下载」里的「转录小工具-说明.txt」，把这个文件发给我即可。" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  set msg to item 1 of argv
  try
    display dialog msg with title "转录小工具" buttons {"好"} default button "好"
  end try
end run
APPLESCRIPT
  exit 1
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

curl_fetch() {
  local dest="$1"
  shift
  local url
  rm -f "$dest"
  for url in "$@"; do
    [[ -n "$url" ]] || continue
    log "fetch $url"
    if curl -fL --retry 2 --retry-delay 2 --connect-timeout 20 --max-time 180 -o "$dest" "$url"; then
      return 0
    fi
    rm -f "$dest"
  done
  return 1
}

github_fetch() {
  local dest="$1"
  local url="$2"
  curl_fetch "$dest" \
    "$url" \
    "https://ghfast.top/${url}" \
    "https://ghproxy.net/${url}"
}

usable_python() {
  local p="$1"
  [[ -n "$p" && -e "$p" ]] || return 1
  chmod +x "$p" 2>/dev/null || true
  xattr -d com.apple.quarantine "$p" 2>/dev/null || true
  log "probe python $p"
  ls -l@ "$p" >>"$LOG" 2>&1 || true
  /usr/bin/file "$p" >>"$LOG" 2>&1 || true
  if "$p" -c 'import sys; print(sys.version)' >>"$LOG" 2>&1; then
    "$p" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null
    return $?
  fi
  log "python probe failed status=$?"
  return 1
}

copy_tree_clean() {
  local from="$1" to="$2"
  rm -rf "$to"
  if /usr/bin/ditto --norsrc --noextattr --noqtn "$from" "$to" 2>>"$LOG"; then
    :
  else
    mkdir -p "$to"
    rsync -a "$from/" "$to/"
  fi
  xattr -cr "$to" 2>/dev/null || true
}

prepare_runtime_python() {
  local dest="$DATA/runtime"
  local py="$dest/bin/python3.12"
  [[ -e "$py" ]] || py="$dest/bin/python3"
  if usable_python "$py"; then
    RUNTIME_PY="$py"
    return 0
  fi

  local arch_pat="aarch64"
  [[ "$ARCH" == "x86_64" ]] && arch_pat="x86_64"
  local src="" d
  log "look for bundled python arch=$ARCH resources=$RESOURCES"
  ls -la "$RESOURCES" >>"$LOG" 2>&1 || true
  ls -la "$RESOURCES/python" >>"$LOG" 2>&1 || true
  for d in "$RESOURCES"/python/cpython-*-macos-${arch_pat}-none; do
    [[ -e "$d/bin" ]] || continue
    if [[ -L "$d" ]]; then continue; fi
    src="$d"
  done
  if [[ -z "$src" ]]; then
    for d in "$RESOURCES"/python/cpython-*-macos-${arch_pat}-none; do
      [[ -e "$d/bin" ]] || continue
      src="$d"
      break
    done
  fi
  if [[ -n "$src" ]]; then
    log "copy python from $src"
    copy_tree_clean "$src" "$dest"
    chmod -R u+x "$dest/bin" 2>/dev/null || true
    py="$dest/bin/python3.12"
    [[ -e "$py" ]] || py="$dest/bin/python3"
    if usable_python "$py"; then
      RUNTIME_PY="$py"
      return 0
    fi
    log "copied python not usable: $py"
  else
    log "no bundled python for $arch_pat"
  fi

  local tag="20260901" ver="3.12.14" plat="aarch64-apple-darwin"
  [[ "$ARCH" == "x86_64" ]] && plat="x86_64-apple-darwin"
  local name="cpython-${ver}+${tag}-${plat}-install_only.tar.gz"
  local tmp="$DATA/$name"
  log "download python $name"
  if github_fetch "$tmp" "https://github.com/astral-sh/python-build-standalone/releases/download/${tag}/${name}"; then
    rm -rf "$DATA/runtime-unpack" "$dest"
    mkdir -p "$DATA/runtime-unpack"
    tar -xzf "$tmp" -C "$DATA/runtime-unpack"
    if [[ -d "$DATA/runtime-unpack/python" ]]; then
      copy_tree_clean "$DATA/runtime-unpack/python" "$dest"
    fi
    rm -rf "$DATA/runtime-unpack" "$tmp"
    py="$dest/bin/python3.12"
    [[ -e "$py" ]] || py="$dest/bin/python3"
    if usable_python "$py"; then
      RUNTIME_PY="$py"
      return 0
    fi
    log "downloaded python not usable: $py"
  fi
  return 1
}

ensure_uv() {
  local dest="$DATA/bin/uv"
  local cand
  local cands=()
  if [[ "$ARCH" == "x86_64" ]]; then
    cands=("$RESOURCES/bin/uv-x86_64" "$RESOURCES/bin/uv")
  else
    cands=("$RESOURCES/bin/uv-arm64" "$RESOURCES/bin/uv-aarch64" "$RESOURCES/bin/uv")
  fi
  for cand in "${cands[@]}"; do
    [[ -x "$cand" ]] || continue
    log "try bundled uv $cand"
    copy_exec "$cand" "$dest"
    if runs_here "$dest"; then
      return 0
    fi
    log "bundled uv does not run on arch=$ARCH: $cand"
    rm -f "$dest"
  done
  if runs_here "$dest"; then
    xattr -cr "$dest" 2>/dev/null || true
    return 0
  fi
  rm -f "$dest"
  local asset="uv-aarch64-apple-darwin.tar.gz"
  [[ "$ARCH" == "x86_64" ]] && asset="uv-x86_64-apple-darwin.tar.gz"
  local tmp="$DATA/uv.tgz"
  log "download uv $asset"
  if ! github_fetch "$tmp" "https://github.com/astral-sh/uv/releases/latest/download/${asset}"; then
    log "uv download failed; pip fallback later"
    return 1
  fi
  tar -xzf "$tmp" -C "$DATA/bin"
  rm -f "$tmp"
  if [[ ! -x "$dest" ]]; then
    local found
    found="$(find "$DATA/bin" -name uv -type f | head -1)"
    [[ -n "$found" ]] && cp "$found" "$dest"
  fi
  chmod +x "$dest" 2>/dev/null || true
  xattr -cr "$dest" 2>/dev/null || true
  if runs_here "$dest"; then
    return 0
  fi
  log "downloaded uv does not run"
  rm -f "$dest"
  return 1
}

ensure_ffmpeg() {
  if runs_here "$DATA/bin/ffmpeg" && runs_here "$DATA/bin/ffprobe"; then
    return 0
  fi
  rm -f "$DATA/bin/ffmpeg" "$DATA/bin/ffprobe"
  if [[ -x "$RESOURCES/bin/ffmpeg" && -x "$RESOURCES/bin/ffprobe" ]]; then
    copy_exec "$RESOURCES/bin/ffmpeg" "$DATA/bin/ffmpeg"
    copy_exec "$RESOURCES/bin/ffprobe" "$DATA/bin/ffprobe"
    if runs_here "$DATA/bin/ffmpeg" && runs_here "$DATA/bin/ffprobe"; then
      return 0
    fi
    rm -f "$DATA/bin/ffmpeg" "$DATA/bin/ffprobe"
  fi
  if have_cmd ffmpeg && have_cmd ffprobe; then
    local ff
    ff="$(command -v ffmpeg)"
    if [[ "$ff" != "$DATA/bin/ffmpeg" ]] && runs_here "$ff"; then
      log "using system ffmpeg $ff"
      return 0
    fi
  fi
  local tag="b6.1.1"
  local ffname="ffmpeg-darwin-arm64.gz"
  local fpname="ffprobe-darwin-arm64.gz"
  [[ "$ARCH" == "x86_64" ]] && ffname="ffmpeg-darwin-x64.gz" && fpname="ffprobe-darwin-x64.gz"
  log "download ffmpeg"
  github_fetch "$DATA/bin/ffmpeg.gz" \
    "https://github.com/eugeneware/ffmpeg-static/releases/download/${tag}/${ffname}" \
    || fail "没法下载音频组件。请检查网络后再打开一次。"
  github_fetch "$DATA/bin/ffprobe.gz" \
    "https://github.com/eugeneware/ffmpeg-static/releases/download/${tag}/${fpname}" \
    || fail "没法下载音频组件。请检查网络后再打开一次。"
  gunzip -f "$DATA/bin/ffmpeg.gz" "$DATA/bin/ffprobe.gz"
  chmod +x "$DATA/bin/ffmpeg" "$DATA/bin/ffprobe"
  if ! runs_here "$DATA/bin/ffmpeg"; then
    fail "音频组件无法在这台电脑上运行。"
  fi
}

copy_bundled_app() {
  if [[ -d "$RESOURCES/app/backend" ]]; then
    rsync -a --delete --exclude temp --exclude .venv --exclude cookies.txt \
      "$RESOURCES/app/" "$DATA/app/"
    return 0
  fi
  return 1
}

refresh_app() {
  if [[ ! -d "$DATA/app/backend" ]]; then
    if copy_bundled_app; then
      log "using bundled app"
    fi
  fi
  local zip="$DATA/src.zip"
  local tmp="$DATA/src-unpack"
  log "refresh app from GitHub"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  if github_fetch "$zip" "https://codeload.github.com/${REPO}/zip/refs/heads/main" \
    || curl_fetch "$zip" "https://api.github.com/repos/${REPO}/zipball/main"; then
    unzip -q -o "$zip" -d "$tmp" || true
    local inner
    inner="$(find "$tmp" -maxdepth 1 -mindepth 1 -type d | head -1)"
    if [[ -n "$inner" && -d "$inner/backend" ]]; then
      rsync -a --delete --exclude temp --exclude .venv --exclude cookies.txt \
        "$inner/" "$DATA/app/"
      rm -rf "$tmp" "$zip"
      return 0
    fi
  fi
  rm -rf "$tmp" "$zip"
  if [[ -d "$DATA/app/backend" ]]; then
    log "keep existing app copy"
    return 0
  fi
  if copy_bundled_app; then
    log "using bundled app"
    return 0
  fi
  fail "没法下载程序文件。请检查网络后再打开一次。"
}

ensure_venv() {
  local uv="$DATA/bin/uv"
  if [[ -x "$DATA/venv/bin/python" ]] && ! "$DATA/venv/bin/python" -c 'import sys' 2>/dev/null; then
    log "drop unusable venv"
    rm -rf "$DATA/venv"
  fi
  if [[ -d "$DATA/venv" && ! -x "$DATA/venv/bin/python" ]]; then
    log "drop broken venv"
    rm -rf "$DATA/venv"
  fi
  if [[ ! -x "$DATA/venv/bin/python" ]]; then
    log "create venv"
    local py=""
    RUNTIME_PY=""
    prepare_runtime_python || true
    py="${RUNTIME_PY:-}"
    if [[ -z "$py" ]]; then
      local syspy=""
      if usable_python /usr/bin/python3; then
        syspy="/usr/bin/python3"
      elif have_cmd python3 && usable_python "$(command -v python3)"; then
        syspy="$(command -v python3)"
      fi
      py="$syspy"
    fi
    if [[ -z "$py" ]]; then
      fail "没法准备 Python。请看已打开的说明页。"
    fi
    log "venv python=$py"
    rm -rf "$DATA/venv"
    if ! "$py" -m venv "$DATA/venv"; then
      if runs_here "$uv"; then
        "$uv" venv "$DATA/venv" --python "$py" || fail "没法创建运行环境。"
      else
        fail "没法创建运行环境。"
      fi
    fi
  fi
  log "install python packages"
  local req="$DATA/app/requirements.txt"
  local vpy="$DATA/venv/bin/python"
  if ! "$vpy" -m pip --version >>"$LOG" 2>&1; then
    "$vpy" -m ensurepip --upgrade >>"$LOG" 2>&1 || true
  fi
  local indexes=(
    "https://mirrors.aliyun.com/pypi/simple/"
    "https://mirrors.cloud.tencent.com/pypi/simple"
    "https://pypi.mirrors.ustc.edu.cn/simple/"
    "https://pypi.tuna.tsinghua.edu.cn/simple"
    "https://pypi.org/simple"
  )
  local idx host
  for idx in "${indexes[@]}"; do
    host="$(printf '%s' "$idx" | sed -E 's#^https?://##' | cut -d/ -f1)"
    log "try index $idx"
    if runs_here "$uv"; then
      if "$uv" pip install --python "$vpy" -r "$req" --index-url "$idx" >>"$LOG" 2>&1; then
        return 0
      fi
      log "uv pip failed on $idx"
    fi
    if "$vpy" -m pip install -r "$req" -i "$idx" --trusted-host "$host" --timeout 60 --retries 2 >>"$LOG" 2>&1; then
      return 0
    fi
    log "pip failed on $idx"
  done
  fail "没法安装依赖。请检查网络后再打开一次。"
}

start_server() {
  stop_bootstrap
  if helper_ready; then
    return 0
  fi
  if [[ -f "$PIDFILE" ]]; then
    local old
    old="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "$old" ]] && kill -0 "$old" 2>/dev/null; then
      log "waiting for pid $old"
    else
      rm -f "$PIDFILE"
    fi
  fi
  log "start server"
  cd "$DATA/app"
  nohup "$DATA/venv/bin/python" start.py --prod >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
}

wait_ready() {
  local i
  for i in $(seq 1 90); do
    if helper_ready; then
      return 0
    fi
    sleep 1
  done
  fail "服务启动超时。关掉再打开一次「转录小工具」试试。"
}

log "launch begin arch=$ARCH scheme=$SCHEME_LAUNCH launcher=20260910h resources=$RESOURCES"
ensure_uv
refresh_app
ensure_venv
ensure_ffmpeg
start_server
wait_ready
notify "已经准备好" "回到原来的网页就能继续转录。"
log "launch ok"
exit 0
