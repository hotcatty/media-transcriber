# 复制为 .env 后按需修改。本地转录默认不需要任何云端 Key。

# HuggingFace 镜像（国内必须，须在 import 模型库之前生效）
HF_ENDPOINT=https://hf-mirror.com

# 服务
MT_HOST=127.0.0.1
MT_PORT=8766

# 引擎：auto = Apple Silicon 用 MLX，其他平台用 faster-whisper
# 也可强制 mlx / faster-whisper
MT_ENGINE=auto
MT_MLX_MODEL=mlx-community/whisper-large-v3-turbo
MT_FW_MODEL=large-v3

# 可选：OpenAI 兼容的云端转录（/v1/audio/transcriptions）
# 不填则始终走本地引擎
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
